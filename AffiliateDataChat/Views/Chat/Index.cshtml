@model ChatPageViewModel
@{
    ViewData["Title"] = "Chat";
    var lastIndex = Model.Messages.Count - 1;
}

<div class="chat-layout">
    <section class="chat-panel" aria-labelledby="chatHeading">
        <div class="chat-panel-header">
            <div>
                <h1 id="chatHeading" class="h4 mb-1">Campaign performance chat</h1>
                <p class="text-muted small mb-0">Ask which campaigns to repeat and which affiliates need support. Answers come from verified tool results.</p>
            </div>
            <div class="status-block">
                <partial name="_ModeBadge" model="(Model.Status.Mode, Model.Status.ModelName)" />
                <span class="small text-muted">@Model.Status.DiscoveredTools.Count tools available</span>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Status.StatusMessage))
        {
            <div class="alert alert-info small py-2 mb-0 rounded-0" role="status">@Model.Status.StatusMessage</div>
        }

        <div class="chat-log" id="chatLog" aria-live="polite" aria-label="Conversation">
            @if (Model.Messages.Count == 0)
            {
                <div class="empty-state">
                    <p class="mb-1 fw-semibold">No messages yet.</p>
                    <p class="mb-0 text-muted small">Pick a suggested question or type your own below.</p>
                </div>
            }

            @for (var i = 0; i < Model.Messages.Count; i++)
            {
                var m = Model.Messages[i];
                var isLatest = i == lastIndex;
                <article class="msg @(m.IsUser ? "msg-user" : "msg-assistant") @(m.IsError ? "msg-error" : "")"
                         id="@(isLatest ? "latest" : null)">
                    <header class="msg-meta">
                        <span class="msg-author">@(m.IsUser ? "You" : "Assistant")</span>
                        <time datetime="@m.Timestamp.ToString("o")" class="local-time">@m.Timestamp.ToString("HH:mm") UTC</time>
                        @if (!m.IsUser && !m.IsError && m.Mode is not null)
                        {
                            <partial name="_ModeBadge" model="(m.Mode.Value, m.ModelName)" />
                        }
                        @if (m.IsError)
                        {
                            <span class="mode-badge mode-error">Not answered</span>
                        }
                    </header>

                    @* Answers are shown as plain, HTML-encoded text (Razor encodes @m.Content), so a model or user can't inject markup. *@
                    <div class="msg-body">@m.Content</div>

                    @if (!m.IsUser && !m.IsError)
                    {
                        <details class="tool-evidence">
                            <summary>
                                Tool evidence
                                <span class="badge bg-light text-dark border">@m.ToolCalls.Count call@(m.ToolCalls.Count == 1 ? "" : "s")</span>
                            </summary>
                            @if (m.ToolCalls.Count == 0)
                            {
                                <p class="small text-muted mb-0 mt-2">No tool calls were reported for this answer.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm evidence-table mb-0 mt-2">
                                        <thead>
                                            <tr><th scope="col">#</th><th scope="col">Tool</th><th scope="col">Arguments</th><th scope="col">Result</th><th scope="col">Time</th></tr>
                                        </thead>
                                        <tbody>
                                            @for (var t = 0; t < m.ToolCalls.Count; t++)
                                            {
                                                var call = m.ToolCalls[t];
                                                <tr>
                                                    <td>@(t + 1)</td>
                                                    <td>
                                                        <code>@call.ToolName</code>
                                                        @if (!call.Succeeded)
                                                        {
                                                            <span class="badge bg-danger ms-1">failed</span>
                                                        }
                                                    </td>
                                                    <td><code class="args">@call.ArgumentsJson</code></td>
                                                    <td>@call.ResultSummary</td>
                                                    <td class="text-nowrap">@call.DurationMs ms</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </details>
                    }
                </article>
            }
        </div>

        <form asp-action="Ask" method="post" class="chat-form" id="chatForm" novalidate>
            @* asp-action on a POST form adds the hidden anti-forgery token automatically *@
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <label asp-for="Input.Question" class="visually-hidden"></label>
            <textarea asp-for="Input.Question"
                      class="form-control" rows="2"
                      maxlength="@ChatInputModel.MaxLength"
                      placeholder="e.g. Which affiliates participated in campaign 2 but made no sales?"
                      aria-describedby="questionHelp questionCount"></textarea>
            <span asp-validation-for="Input.Question" class="text-danger small d-block mt-1" role="alert"></span>
            <div class="chat-form-footer">
                <small id="questionHelp" class="text-muted">Enter to send · Shift+Enter for a new line</small>
                <small id="questionCount" class="text-muted char-count" data-max="@ChatInputModel.MaxLength">0 / @ChatInputModel.MaxLength</small>
                <button type="submit" class="btn btn-primary" id="sendButton">
                    <span class="send-label">Send</span>
                    <span class="sending-label">Thinking…</span>
                </button>
            </div>
        </form>
    </section>

    <aside class="side-panel" aria-labelledby="suggestHeading">
        <h2 id="suggestHeading" class="h6">Suggested questions</h2>
        <ul class="suggestions">
            @foreach (var q in Model.SuggestedQuestions)
            {
                <li>
                    @* Each suggestion is its own small form, so it works without JavaScript and still sends an anti-forgery token. *@
                    <form asp-action="Ask" method="post">
                        <input type="hidden" name="Input.Question" value="@q" />
                        <button type="submit" class="suggestion">@q</button>
                    </form>
                </li>
            }
        </ul>

        @if (Model.Messages.Count > 0)
        {
            <form asp-action="Clear" method="post" class="mt-3">
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Clear conversation</button>
            </form>
        }

        <p class="small text-muted mt-3 mb-0">
            Net revenue = gross revenue − discounts − refunds. Revenue after commission is not profit.
            <a asp-controller="Home" asp-action="About">How this works</a>
        </p>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
